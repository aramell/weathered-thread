# Resend (email signup, app/(site)/actions.ts, AD-6) — from the Vercel
# Marketplace Resend integration; pull the real value with `vercel env pull`.
RESEND_API_KEY=

# Etsy Open API v3. Holds the full "<keystring>:<shared_secret>" string of your Etsy
# app. Used by scripts/sync-etsy.ts (locally / in the GitHub Action) and, set in Vercel
# env too, by lib/etsy-live.ts for live inventory at request time.
ETSY_API_KEY=

# Etsy OAuth refresh token (scope listings_r), written by `npm run auth:etsy` and
# rotated by `npm run sync:etsy`. Local use only, like ETSY_API_KEY.
ETSY_REFRESH_TOKEN=

# Live inventory (lib/etsy-live.ts), Vercel only. A SECOND refresh token, separate from
# ETSY_REFRESH_TOKEN above: Etsy rotates the token on every use, so the sync and the live
# reads each need their own chain. Mint it with `npm run auth:etsy`, copy it from .env.local
# into Vercel as ETSY_LIVE_REFRESH_TOKEN, then restore ETSY_REFRESH_TOKEN locally. It only
# seeds the first refresh; the rotating pair then lives in Vercel Blob (BLOB_READ_WRITE_TOKEN,
# added by connecting a Blob store to the project). Without BLOB_READ_WRITE_TOKEN the site
# serves the synced catalog, which is what you get locally.
ETSY_LIVE_REFRESH_TOKEN=

# Checkout Handoff forward (app/go/[slug]); defaults to https://shop.weatheredthread.com.
SHOP_ORIGIN=
