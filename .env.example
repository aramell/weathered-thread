# Resend (email signup, app/(site)/actions.ts, AD-6) — from the Vercel
# Marketplace Resend integration; pull the real value with `vercel env pull`.
RESEND_API_KEY=

# Etsy Open API v3. Holds the full "<keystring>:<shared_secret>" string of your Etsy
# app. Used by scripts/sync-etsy.ts (locally / in the GitHub Action) and, set in Vercel
# env too, by lib/etsy-live.ts for live inventory at request time.
ETSY_API_KEY=

# Etsy OAuth refresh token (scope listings_r), written by `npm run auth:etsy` and
# rotated by `npm run sync:etsy`. Local use only, like ETSY_API_KEY.
ETSY_REFRESH_TOKEN=

# Live inventory (lib/etsy-live.ts), Vercel only. A SECOND refresh token, separate from
# ETSY_REFRESH_TOKEN above: Etsy rotates the token on every use, so the sync and the live
# reads each need their own chain. Mint it with `npm run auth:etsy`, copy it from .env.local
# into Vercel as ETSY_LIVE_REFRESH_TOKEN, then restore ETSY_REFRESH_TOKEN locally. It only
# seeds the first refresh; the rotating pair then lives in Vercel Blob (BLOB_READ_WRITE_TOKEN,
# added by connecting a Blob store to the project). Without BLOB_READ_WRITE_TOKEN the site
# serves the synced catalog, which is what you get locally.
ETSY_LIVE_REFRESH_TOKEN=

# Where Square sends the visitor after paying (/checkout/thank-you); defaults to the live site,
# https://weatheredthread.com. Set it only to return somewhere else, e.g. http://localhost:3000.
SHOP_ORIGIN=

# Square (lib/square-client.ts), server-only. SQUARE_ENVIRONMENT is "sandbox" (the default
# when unset) or "production" and picks which pair below is read. Develop on sandbox
# (developer.squareup.com > your application > Credentials > Sandbox; the location id is
# under Sandbox test accounts > Locations); set production values in Vercel env only.
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Square order webhook (app/api/square/webhook, lib/square-webhook.ts). Same sandbox/production
# split as above. In Developer Console > Webhooks, subscribe to payment.updated at the url
# below, then copy the subscription's Signature key. *_WEBHOOK_URL must match the subscription's
# notification url exactly, because Square signs it. ORDER_NOTIFY_EMAIL receives one email per paid
# order; mail is sent from orders@RESEND_EMAIL_DOMAIN.
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_SANDBOX_WEBHOOK_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
ORDER_NOTIFY_EMAIL=
RESEND_EMAIL_DOMAIN=
