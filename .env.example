# Resend (email signup, app/(site)/actions.ts, AD-6) — from the Vercel
# Marketplace Resend integration; pull the real value with `vercel env pull`.
RESEND_API_KEY=

# Etsy Open API v3 (scripts/sync-etsy.ts, manual catalog sync only). Holds the
# full "<keystring>:<shared_secret>" string of your Etsy app. Local use only —
# never set this in Vercel env; the site never calls Etsy at build or runtime.
ETSY_API_KEY=
